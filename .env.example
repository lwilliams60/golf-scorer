# Live sync (Supabase project settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sign in by text message. Set to 1 once Twilio is connected in Supabase (Authentication > Sign In / Providers > Phone)
VITE_PHONE_SIGNIN=

# UK course search (server-side only, never prefix with VITE_). RapidAPI key for the UK Golf Course Data API.
GOLF_API_KEY=
